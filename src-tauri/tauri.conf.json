{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "server2pick",
  "version": "0.2.0",
  "identifier": "dev.kayschnieders.server2pick",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "server2pick",
        "width": 1180,
        "height": 820,
        "minWidth": 940,
        "minHeight": 620,
        "theme": "Dark",
        "backgroundColor": "#0b0d0f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kschnieders/server2pick/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBQTJEQUQwN0Q1Q0Y0QzEKUldUQjlGeDkwTnFpV3BNZW9SQnAvSEg3SThxSTJXSXltMkxQNTh1d1k1QmZmT3NPYWtMMzdqOU0K",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Kay Schnieders",
    "shortDescription": "Server picker for Deadlock, CS2, Dota 2 and TF2",
    "longDescription": "Lists Valve's relay locations per game with live ping and blocks the unwanted ones through the Windows firewall — separately per game, because every rule is bound to that game's executable.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
